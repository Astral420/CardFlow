DATABASE_URL=postgresql+psycopg2://card_tool:card_tool@localhost:5432/card_tool
REDIS_URL=redis://localhost:6379/0
REDIS_RESULT_BACKEND_URL=redis://localhost:6379/1
# Session revocation state (access-token revocation markers, refresh-token
# families). Separate DB index from Celery's traffic above.
REDIS_AUTH_URL=redis://localhost:6379/2

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=card-tool

# The API refuses to start if either of these is left at "change-me".
SECRET_KEY=change-me
APP_PASSCODE=change-me

ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=30
#
# The refresh token ships as a cross-site cookie (Vercel frontend,
# Cloudflare-tunneled API) -- SameSite=none + Secure are required for the
# browser to accept it at all in production. For local dev over plain
# HTTP, uncomment these two so the cookie survives on http://localhost:
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
